# Dev convenience, NOT used in production and not auto-applied by
# `docker compose up` (Compose only auto-merges a file literally named
# `docker-compose.override.yml`). To use it:
#
#   cp docker-compose.override.yml.example docker-compose.override.yml
#   docker compose up --build
#
# This swaps backend/frontend to their `dev` build stage (see
# backend/Dockerfile, frontend/Dockerfile) and bind-mounts source so edits
# hot-reload: backend via `mvn spring-boot:run` + spring-boot-devtools,
# frontend via the Vite dev server with HMR - instead of the production
# jar/nginx images the base docker-compose.yml builds.
services:
  backend:
    build:
      target: dev
    volumes:
      - ./backend:/app
      - maven_repo:/root/.m2
    command: mvn spring-boot:run

  frontend:
    build:
      target: dev
    volumes:
      - ./frontend:/app
      - /app/node_modules
    # `ports` merges by concatenation across files by default, which would
    # leave both the base image's :80 mapping and this :5173 one publishing
    # to the same host port - !override forces a clean replace instead.
    ports: !override
      - "${FRONTEND_PORT:-5173}:5173"
    environment:
      VITE_API_BASE_URL: /api/v1

volumes:
  maven_repo:
