# Database
POSTGRES_DB=tcm
POSTGRES_USER=tcm
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

# Ports
BACKEND_PORT=8080
FRONTEND_PORT=5173

# Auth
JWT_SECRET=changeme
JWT_EXPIRATION_MS=86400000
# The one origin the API accepts cross-origin calls from. The bundled
# frontend (nginx, or the Vite dev proxy) calls the API same-origin, so this
# only matters when a browser talks to the backend port directly. Defaults to
# http://localhost:${FRONTEND_PORT}.
#CORS_ALLOWED_ORIGIN=http://localhost:5173

# Bootstrap administrator, seeded once on a fresh database (changing these
# later has no effect until `docker compose down -v`). The hash is BCrypt,
# not plaintext - keep it in single quotes so Compose doesn't read its `$`s
# as variables. Defaults: admin@tcm.local / hash of ChangeMe123!.
#BOOTSTRAP_ADMIN_EMAIL=admin@tcm.local
#BOOTSTRAP_ADMIN_PASSWORD_HASH='$2a$10$...'

# Liquibase contexts: `demo` (default) also seeds the sample dataset; `prod`
# starts with only the bootstrap administrator.
LIQUIBASE_CONTEXTS=demo

# QR attendance (TCM-27/28)
# The origin the QR code's check-in link points at. It MUST match the origin
# students actually open the frontend on - a code encoding localhost is
# unscannable from a phone, so set this to the machine's LAN address (e.g.
# http://192.168.1.20:5173) when demoing with real devices.
FRONTEND_BASE_URL=http://localhost:5173
# Signs the per-session QR tokens; falls back to JWT_SECRET when unset.
QR_SECRET=changeme
# How long a session's QR code stays valid before the trainer shows a new one.
QR_VALIDITY_MINUTES=15

# Certificates (TCM-25)
# Where generated PDFs are written. Only read by a backend run outside
# Docker (default ./data/certificates): in Docker the path is fixed at
# /var/lib/tcm/certificates by application-docker.yml, matching the named
# volume docker-compose.yml mounts there, and this variable is ignored.
#CERTIFICATES_STORAGE_PATH=./data/certificates
# Attendance percentage a student must reach to be certified.
CERTIFICATES_MIN_ATTENDANCE_RATE=75
